# Separate runtime recipe. Historical evidence retains its original image ID.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# The base image names live Debian mirrors. Freeze both archives to the date of
# the original evaluator build so later security/archive changes do not silently
# change the runtime. This is not a substitute for checking the rebuilt image.
RUN set -eux; \
    sed -i \
      -e 's#http://deb.debian.org/debian-security#https://snapshot.debian.org/archive/debian-security/20260913T080000Z/#' \
      -e 's#http://deb.debian.org/debian#https://snapshot.debian.org/archive/debian/20260913T080000Z/#' \
      /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends graphviz=2.42.4-3 libgomp1=14.2.0-19; \
    rm -rf /var/lib/apt/lists/*

COPY requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock

WORKDIR /work
USER 65534:65534
